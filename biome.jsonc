{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "root": true,
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      // `!!` 是 force-ignore：普通 `!` 只是不检查，被别的文件 import 时 scanner 仍会索引；
      // types 域会触发全项目扫描，这些目录必须用 `!!` 彻底挡住，否则 LSP daemon 高 CPU
      "!!**/dist",
      "!!**/.turbo",
      "!!**/coverage",
      "!!**/.reforce",
      "!!**/.idea",
      "!!**/.worktrees",
      "!!apm_modules",
      "!!patches",
      "!!.claude",
      "!!.codex",
      "!!.agents",
      "!!.kimi-code",
      "!!pnpm-lock.yaml",
      "!!.lsp.json",
      "!!.mcp.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "test": "recommended",
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        }
      },
      "suspicious": {
        // 吞错必须写理由：空 catch/空块一律拒绝，含理由注释的块被该规则放行，
        // 于是「每个吞错点写清为什么」从口头纪律变成机器拦截（#314）。
        "noEmptyBlockStatements": "error"
      }
    }
  },
  "overrides": [
    {
      // 测试/bench 里大量 `() => {}` 是合法的 noop 替身，不是吞错；空块拦截只对生产代码
      // （src/**）执行，测试目录整体豁免（#314）。
      "includes": ["**/test/**", "**/it/**", "**/bench/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlockStatements": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    },
    "linter": { "enabled": true },
    "formatter": { "trailingCommas": "none" }
  }
}
