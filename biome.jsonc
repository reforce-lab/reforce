{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "root": true,
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      // `!!` 是 force-ignore：普通 `!` 只是不检查，被别的文件 import 时 scanner 仍会索引；
      // types 域会触发全项目扫描，这些目录必须用 `!!` 彻底挡住，否则 LSP daemon 高 CPU
      "!!**/dist",
      "!!**/.turbo",
      "!!**/coverage",
      "!!**/.reforce",
      "!!**/.idea",
      "!!**/.worktrees",
      "!!apm_modules",
      "!!patches",
      "!!.claude",
      "!!.codex",
      "!!.agents",
      "!!.kimi-code",
      "!!bun.lock",
      "!!.lsp.json",
      "!!.mcp.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "test": "recommended",
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    },
    "linter": { "enabled": true },
    "formatter": { "trailingCommas": "none" }
  }
}
