{
  "name": "reforce",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A Spring-like application framework ecosystem for Node.js.",
  "repository": {
    "type": "git",
    "url": "https://github.com/reforce-lab/reforce"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=!@reforce/e2e",
    "test:e2e": "turbo run test:e2e --filter=@reforce/e2e",
    "check": "turbo run check",
    "check:write": "turbo run check:write",
    "prepare": "lefthook install && apm install && apm compile"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.8",
    "typescript": "catalog:"
  }
}
