{
  "name": "reforce",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A Spring-like application framework ecosystem for the Bun era.",
  "repository": {
    "type": "git",
    "url": "https://github.com/reforce-lab/reforce"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "e2e",
    "packages/*",
    "platforms/*",
    "tooling/*"
  ],
  "catalog": {
    "@biomejs/biome": "^2.5.6",
    "@rslib/core": "^0.23.2",
    "@swc/helpers": "^0.5.23",
    "@types/bun": "^1.3.14",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter='!@reforce/e2e'",
    "test:e2e": "turbo run test:e2e --filter=@reforce/e2e",
    "check": "turbo run check",
    "check:write": "turbo run check:write",
    "prepare": "lefthook install && apm install && apm compile"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.8",
    "typescript": "catalog:"
  },
  "patchedDependencies": {
    "get-tsconfig@4.14.1": "patches/get-tsconfig@4.14.1.patch"
  }
}
