# deps
node_modules/

# build output
dist/
.reforce/
*.tsbuildinfo

# e2e fixture starter 的 dist 是手写的已构建面（reforce lib 的输入），必须提交
!/e2e/fixtures/*/dist/
!/e2e/fixtures/*/dist/**

# 真 starter 包的 meta 三件套由 `reforce lib` 随 build 产出（#153），与 dist 同为构建产物。
# 用通配而不是逐包罗列：新增引擎包时漏写一行就会把构建产物提交进来（e2e 夹具在 /e2e 下，不受影响）。
# 两层通配对应 packages/<分组>/<包>/：写成一层不是「少忽略几个文件」，而是整条规则失配、
# 三件套全部变成待提交，同时 biome 会连带把生成的 json 一起检查（它默认读 .gitignore）。
/packages/*/*/reforce-meta.json
/packages/*/*/reforce.js
/packages/*/*/reforce.d.ts

# turbo
.turbo/

# test / coverage
coverage/
/e2e/e2e-junit.xml
/packages/devkit/cli/recovery-junit.xml

# logs
*.log

# os
.DS_Store

# ide
.idea/
.vscode/
!.vscode/settings.json

# env
.env
.env.*
!.env.example

# apm —— 真相源头是 apm.yml + .apm/，以下为编译/安装产物
# （以 / 开头只匹配根目录；apm.lock.yaml 同 pnpm-lock.yaml 一样需要提交，不在此列）
/AGENTS.md
/CLAUDE.md
.worktrees
.kimi-code
.agents
.claude
.codex
apm_modules/
