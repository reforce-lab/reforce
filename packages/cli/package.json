{
  "name": "@reforce/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "reforce": "./dist/reforce.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p test/tsconfig.json && tsc -p it/tsconfig.json",
    "test": "vitest run",
    "test:recovery": "vitest run it/recovery/project-lease.spec.ts it/recovery/directory-transaction.spec.ts",
    "test:recovery:evidence": "vitest run it/recovery/project-lease.spec.ts it/recovery/directory-transaction.spec.ts --reporter=junit --outputFile=recovery-junit.xml",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "dependencies": {
    "@reforce/compiler": "workspace:*",
    "@reforce/config": "workspace:*",
    "@reforce/core": "workspace:*",
    "@reforce/primitives": "workspace:*",
    "@reforce/runtime": "workspace:*",
    "@reforce/transaction": "workspace:*",
    "@reforce/web": "workspace:*",
    "@rsbuild/core": "^2.1.9",
    "@swc/helpers": "catalog:",
    "commander": "^15.0.0",
    "radashi": "^12.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@reforce/tooling-rslib": "workspace:*",
    "@reforce/tooling-testing": "workspace:*",
    "@reforce/tooling-tsconfig": "workspace:*",
    "@reforce/tooling-vitest": "workspace:*",
    "@rslib/core": "catalog:",
    "@types/node": "catalog:",
    "execa": "^10.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
