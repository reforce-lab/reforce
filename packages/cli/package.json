{
  "name": "@reforce/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "reforce": "./dist/reforce.js"
  },
  "scripts": {
    "build": "rslib build && bun tooling/mark-executable.ts",
    "typecheck": "tsc",
    "test": "bun run test:fixtures && bun --conditions=development test --timeout 15000 src __tests__/commands __tests__/integration __tests__/process __tests__/recovery",
    "test:e2e": "bun run test:fixtures && bun --conditions=development test __tests__/e2e",
    "test:e2e:evidence": "bun run test:fixtures && bun --conditions=development test __tests__/e2e --reporter=junit --reporter-outfile=e2e-junit.xml",
    "test:fixtures": "rslib build -c rslib.fixtures.config.ts",
    "test:recovery": "bun run test:fixtures && bun --conditions=development test __tests__/recovery/project-lease.spec.ts __tests__/recovery/directory-transaction.spec.ts",
    "test:recovery:evidence": "bun run test:fixtures && bun --conditions=development test __tests__/recovery/project-lease.spec.ts __tests__/recovery/directory-transaction.spec.ts --reporter=junit --reporter-outfile=recovery-junit.xml",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "dependencies": {
    "@babel/helper-validator-identifier": "^8.0.4",
    "@dagrejs/graphlib": "^4.0.1",
    "@reforce/compiler": "workspace:*",
    "@reforce/compiler-yuku": "workspace:*",
    "@reforce/context": "workspace:*",
    "@rsbuild/core": "^2.1.9",
    "@swc/helpers": "catalog:",
    "commander": "^15.0.0",
    "enhanced-resolve": "^5.24.5",
    "execa": "^10.0.1",
    "get-tsconfig": "^4.14.1",
    "json-stable-stringify": "^1.3.0",
    "lru-cache": "^11.5.2",
    "radashi": "^12.9.1",
    "tinyglobby": "^0.2.17",
    "yuku-parser": "0.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@reforce/tooling-testing": "workspace:*",
    "@reforce/tooling-tsconfig": "workspace:*",
    "@rslib/core": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
