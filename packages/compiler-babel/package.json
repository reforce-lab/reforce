{
  "name": "@reforce/compiler-babel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#internal/*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#tooling/*": {
      "types": "./tooling/*.ts",
      "development": "./tooling/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "benchmark": "node --conditions=development tooling/benchmark.ts",
    "benchmark:adapter": "node --conditions=development tooling/benchmark.ts --adapter",
    "benchmark:select": "node --conditions=development tooling/select-frontend.ts",
    "fixtures:update": "bun --conditions=development tooling/update-fixtures.ts",
    "typecheck": "tsc",
    "test": "bun --conditions=development test",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@reforce/compiler-spi": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@reforce/compiler": "workspace:*",
    "@reforce/compiler-yuku": "workspace:*",
    "@reforce/tooling-testing": "workspace:*",
    "@reforce/tooling-tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "radashi": "^12.9.1",
    "typescript": "catalog:"
  }
}
