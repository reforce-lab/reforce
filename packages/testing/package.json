{
  "name": "@reforce/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p test/tsconfig.json && tsc -p it/tsconfig.json",
    "test": "vitest run",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "dependencies": {
    "@reforce/context": "workspace:*",
    "@swc/helpers": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@reforce/logging": "workspace:*",
    "@reforce/tooling-rslib": "workspace:*",
    "@reforce/tooling-testing": "workspace:*",
    "@reforce/tooling-tsconfig": "workspace:*",
    "@reforce/tooling-vitest": "workspace:*",
    "@rslib/core": "catalog:",
    "@types/node": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
