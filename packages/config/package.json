{
  "name": "@reforce/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated-runtime": {
      "types": "./dist/generated-runtime.d.ts",
      "default": "./dist/generated-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p test/tsconfig.json && tsc -p it/tsconfig.json",
    "test": "vitest run",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "dependencies": {
    "@reforce/context": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "@swc/helpers": "catalog:",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@reforce/tooling-rslib": "workspace:*",
    "@reforce/tooling-testing": "workspace:*",
    "@reforce/tooling-tsconfig": "workspace:*",
    "@reforce/tooling-vitest": "workspace:*",
    "@rslib/core": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "^4.9.0",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
