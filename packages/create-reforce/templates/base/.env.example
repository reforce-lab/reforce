# 复制成 .env 再改。Reforce 依次读取 .env、.env.local，真实的环境变量优先级最高。
# 变量名由 config/ 里的前缀和字段名推出来：webServer + port → WEB_SERVER_PORT。

WEB_SERVER_PORT=3000

# 监听地址，缺省 localhost（只有本机连得上）。手机戳局域网接口、或者部署进容器要让外面连
# 进来，才打开这行；IPv6 用 ::。对外暴露是个部署决定，所以缺省不替你做。
# WEB_SERVER_HOSTNAME=0.0.0.0

# 配上就会对写接口做校验（请求要带 x-api-key），留空等于关掉。
# APP_API_KEY=change-me-please
