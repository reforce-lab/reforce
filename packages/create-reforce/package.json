{
  "name": "create-reforce",
  "version": "0.0.0",
  "type": "module",
  "description": "Create a Reforce application",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reforce-lab/reforce",
    "directory": "packages/create-reforce"
  },
  "bin": {
    "create-reforce": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p test/tsconfig.json && tsc -p it/tsconfig.json",
    "test": "vitest run",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "dependencies": {
    "@clack/core": "^1.4.3",
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@reforce/tooling-rslib": "workspace:*",
    "@reforce/tooling-tsconfig": "workspace:*",
    "@reforce/tooling-vitest": "workspace:*",
    "@rslib/core": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
