{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // 逐条列出上游而不是 `^build`：`^build` 含 devDependencies，而产 meta 要 devDepend
      // @reforce/cli，那条边会成环（cli → compiler →（devDep）config → logging-contracts）。
      // 本包是全仓最底层之一，运行时零 workspace 依赖。
      "dependsOn": [],
      "outputs": ["dist/**"]
    }
  }
}
