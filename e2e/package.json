{
  "name": "@reforce/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "vitest run test",
    "test:e2e:evidence": "vitest run test --reporter=junit --outputFile=e2e-junit.xml",
