    "@reforce/web-hono": "workspace:*",
    "@reforce/web-node": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@reforce/cli": "workspace:*",
    "@reforce/testing": "workspace:*",
    "@reforce/tooling-testing": "workspace:*",
    "@reforce/tooling-tsconfig": "workspace:*",
    "@reforce/tooling-vitest": "workspace:*",
    "@types/node": "catalog:",
    "radashi": "^12.9.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
