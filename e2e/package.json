{
  "name": "@reforce/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "bun test --timeout 120000 test",
    "test:e2e:evidence": "bun test --timeout 120000 test --reporter=junit --reporter-outfile=e2e-junit.xml",
    "typecheck": "tsc && tsc -p fixtures/application/tsconfig.json",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "dependencies": {
    "@reforce/config": "workspace:*",
    "@reforce/context": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@reforce/cli": "workspace:*",
    "@reforce/tooling-testing": "workspace:*",
    "@reforce/tooling-tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "radashi": "^12.9.1",
    "typescript": "catalog:"
  }
}
