{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    // ^build 只沿 @reforce/e2e 自己的依赖图向上构建（17 个包里的 15 个），而
    // distribution-tarball 套件断言的是磁盘上**全部**包打出来是什么样——两者范围不一致，
    // create-reforce 与 @reforce/transaction-testing 不在图内。所以根脚本 test:e2e 先跑
    // 一次不带 filter 的 turbo run build；直接 `turbo run test:e2e` 会在冷工作区把这两个包
    // 报成「发布契约坏了」，而真实原因是没人构建它们（Issue #304）。
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    // 只有 @reforce/web-core 用它：它一个 bean 都没有，产的是一份纯户口表的 meta，让引擎包的
    // 契约写成 `@reforce/web-core#WebEngineAdapter` 而不是把 web-core 的 dist 布局抄进契约串
    // （#369）。其余 starter 在自己的 rslib build 里由 bundler-plugin 顺带产出。
    //
    // 它必须是**独立任务**而不是 web-core 的 build 的一部分：走 build 就要 devDepend
    // bundler-plugin，而 `^build` 含 devDeps，于是
    // web-core#build → bundler-plugin#build → compiler#build → web-core#build 成环（最后一条
    // 是 compiler 的 IT 夹具要装真的 web-core）。拆成独立任务后 build 链上不再有这条边。
    "meta": {
      "dependsOn": ["build", "@reforce/cli#build"],
      "outputs": ["reforce-meta.json"]
    },
    "check": {
      "outputs": []
    },
    "check:write": {
      "cache": false,
      "outputs": []
    }
  }
}
